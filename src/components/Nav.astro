---
import LogoChiply from './LogoChiply.astro';
import { whatsappLink, buildGeneralMessage, formatearWhatsapp } from '../lib/whatsapp';

const { SITE } = Astro.locals.config;
const wa = whatsappLink(buildGeneralMessage(), SITE.whatsapp);

/**
 * El mockup traía esta banda flotando sobre el gris, con margen a los costados y
 * muy redondeada, sin ningún link adentro (la navegación vivía en el pie). Eso
 * cambió a pedido explícito: ahora ocupa todo el ancho -- mismo gesto que el pie
 * (`Footer.astro`: banda `bg-carbon` de punta a punta con brillo diagonal, y un
 * `max-w-shell` adentro para alinear el contenido) -- y suma navegación. Sticky
 * para que quede a mano mientras se scrollea; el offset lo cubre
 * `scroll-padding-top` en StoreLayout.astro.
 */
const NAV = [
  { href: '#catalogo', label: 'Catálogo' },
  { href: '#donde', label: 'Sucursales' },
];
---

<header id="inicio" class="sticky top-0 z-40 overflow-hidden bg-carbon">
  {/* El brillo diagonal es el mismo gesto que el pie: una banda casi negra, no
      plana, con un reflejo de gradiente cruzándola. Va con estilo inline porque
      es un gradiente puntual de este componente, no un token reutilizable. */}
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: linear-gradient(135deg, #030303 0%, #030303 38%, rgba(255,255,255,0.14) 50%, #030303 62%, #030303 100%)"
  >
  </div>

  <div class="relative mx-auto flex max-w-shell items-center justify-between gap-6 px-4 sm:px-6 lg:px-10 xl:px-14 py-3 sm:py-3.5">
    <a href="#inicio" data-logo-top class="relative shrink-0 cursor-pointer" aria-label="Ir al inicio">
      <LogoChiply clase="h-10 sm:h-12" />
    </a>

    {/* Oculto en mobile: tres links de texto no entran al lado del logo y el
        carrito en una pantalla chica, y en el celular ya se navega scrolleando.
        Texto liso (no píldora) para no competirle al carrito, que es el único
        botón "de acción" del header. */}
    {/* Riel: los dos links sueltos sobre la banda negra quedaban colgados en el
        aire. Adentro de una capsula tienen sobre que apoyarse, y la seccion que
        se esta mirando se pinta amarilla -- el mismo par de estados que las
        pildoras del catalogo (rellena amarilla cuando esta activa, apagada
        cuando no), asi el sitio tiene un solo lenguaje de pildora. */}
    <nav class="relative hidden items-center gap-1 rounded-full bg-white/[0.06] p-1 ring-1 ring-white/10 md:flex">
      {/* La pastilla amarilla es UNA sola y se desliza hasta el link de la seccion
          que se esta mirando, en vez de prenderse y apagarse en cada uno: asi el
          nav cuenta el recorrido de la pagina mientras se scrollea. La mide y la
          mueve el script de abajo, porque el ancho depende del texto. */}
      <span
        data-nav-indicador
        aria-hidden="true"
        class="pointer-events-none absolute left-1 top-1 h-[calc(100%-0.5rem)] w-0 rounded-full bg-amarillo opacity-0 transition-[transform,width,opacity] duration-300 ease-out"
      />
      {NAV.map((item) => (
        <a
          href={item.href}
          data-nav-link={item.href.slice(1)}
          class="relative rounded-full px-4 py-2 text-sm font-bold text-plata transition-colors hover:text-amarillo"
        >
          {item.label}
        </a>
      ))}
    </nav>

    {/* Contacto directo. El WhatsApp de la casa central entra con el numero a la
        vista desde lg; abajo de eso queda el ícono solo, que es lo único que
        entra al lado del logo en una pantalla chica. El carrito no vive mas
        aca: en escritorio esta el boton flotante (CartFab) y en celular la
        barra de pedido (MobileCartBar), que ademas muestra el total. */}
    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener"
        aria-label={`Instagram de ${SITE.nombre}`}
        class="flex h-10 w-10 items-center justify-center rounded-full text-plata transition-colors hover:bg-white/10 hover:text-amarillo"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>

      <a
        href={wa}
        target="_blank"
        rel="noopener"
        aria-label={`WhatsApp de ${SITE.nombre}: ${formatearWhatsapp(SITE.whatsapp)}`}
        class="flex h-10 items-center gap-2 rounded-full px-2.5 text-plata transition-colors hover:bg-white/10 hover:text-amarillo"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.7 15L2 22l5.2-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.4 0-.5s-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.6.6 2.2.7 3 .6a2.5 2.5 0 0 0 1.7-1.2 2 2 0 0 0 .1-1.2c-.1-.1-.3-.2-.6-.3Z" />
        </svg>
        <span class="precio hidden text-sm font-extrabold lg:inline">
          {formatearWhatsapp(SITE.whatsapp)}
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  /**
   * Pinta en el riel del nav la seccion que se esta mirando. El margen de arriba
   * descuenta el alto del header fijo y el de abajo (-55%) evita que dos
   * secciones queden activas a la vez: una seccion cuenta recien cuando ocupa la
   * mitad de arriba de la pantalla. Si hay varias, gana la primera en el orden
   * del documento, que es la que se esta leyendo.
   */
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const indicador = document.querySelector<HTMLElement>('[data-nav-indicador]');
  const aVista = new Set<string>();
  let activo: string | undefined;

  function pintar(): void {
    activo = enlaces.find((e) => aVista.has(e.dataset.navLink ?? ''))?.dataset.navLink;
    for (const enlace of enlaces) {
      const es = enlace.dataset.navLink === activo;
      enlace.classList.toggle('text-tintaFuerte', es);
      enlace.classList.toggle('text-plata', !es);
      enlace.classList.toggle('hover:text-amarillo', !es);
      if (es) {
        enlace.setAttribute('aria-current', 'true');
      } else {
        enlace.removeAttribute('aria-current');
      }
    }
    moverIndicador();
  }

  /** La pastilla se mide contra el link: el ancho sale del texto, no de una constante. */
  function moverIndicador(): void {
    if (!indicador) return;
    const enlace = enlaces.find((e) => e.dataset.navLink === activo);
    if (!enlace) {
      indicador.style.opacity = '0';
      return;
    }
    // offsetLeft ya viene medido contra el <nav>, que es el que tiene `relative`.
    indicador.style.transform = `translateX(${enlace.offsetLeft - 4}px)`;
    indicador.style.width = `${enlace.offsetWidth}px`;
    indicador.style.opacity = '1';
  }

  window.addEventListener('resize', moverIndicador);
  // Las fuentes propias cambian el ancho del texto al terminar de cargar.
  document.fonts?.ready.then(moverIndicador);

  if (enlaces.length > 0 && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          const id = entrada.target.id;
          if (entrada.isIntersecting) aVista.add(id);
          else aVista.delete(id);
        }
        pintar();
      },
      { rootMargin: '-96px 0px -55% 0px', threshold: 0 },
    );
    for (const enlace of enlaces) {
      const seccion = document.getElementById(enlace.dataset.navLink ?? '');
      if (seccion) observador.observe(seccion);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-logo-top]').forEach((logo) => {
    logo.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (window.location.hash) {
        history.pushState(null, '', window.location.pathname);
      }
    });
  });
</script>
