---
import { LOCALES_CHIPLY, CIUDADES_CON_LOCALES } from '../data/locales';
---

<section id="donde" class="border-t border-black/10 py-10 md:py-14">
  <div class="mx-auto max-w-shell px-4 sm:px-6 lg:px-10 xl:px-14">
    {/* Solo el titulo: el WhatsApp de la central vive en el header, donde esta
        siempre a mano, y cada local tiene el suyo en su tarjeta. Repetirlo aca
        era un tercer boton de WhatsApp en la misma pantalla. */}
    <div class="pb-6" data-reveal>
      <h2 class="text-3xl font-bold text-tintaFuerte sm:text-seccion">Dónde encontrarnos</h2>
    </div>

    <!-- Filtros rápidos por ciudad -->
    <div
      class="no-scrollbar -mx-4 flex items-center gap-2 overflow-x-auto px-4 lg:mx-0 lg:px-0 py-2 mb-6"
      data-city-filters
      data-scroll-fundido="horizontal"
    >
      {CIUDADES_CON_LOCALES.map((ciudad, idx) => (
        <button
          type="button"
          data-filter-ciudad={ciudad}
          class:list={[
            'h-9 shrink-0 cursor-pointer rounded-full px-4 text-xs font-bold transition-opacity hover:opacity-90 active:opacity-75',
            idx === 0
              ? 'bg-amarillo text-tintaFuerte is-active'
              : 'bg-carbon text-amarillo'
          ]}
        >
          {ciudad} {ciudad === 'Todas' ? `(${LOCALES_CHIPLY.length})` : `(${LOCALES_CHIPLY.filter(l => l.ciudad === ciudad).length})`}
        </button>
      ))}
    </div>

    <!-- Grilla interactiva: Lista a la izquierda + Mapa interactivo a la derecha -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Lista de locales -->
      <div
        class="lg:col-span-5 flex flex-col gap-3 max-h-[460px] sm:max-h-[520px] lg:max-h-[600px] overflow-y-auto overflow-x-hidden p-2 scroll-fino en-tope-inicio"
        id="lista-locales"
        data-scroll-fundido="vertical"
      >
        {LOCALES_CHIPLY.map((local) => {
          const comoLlegar = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(local.direccion + ', ' + local.ciudad + ', Misiones')}`;
          const waLocal = `https://wa.me/${local.whatsapp}?text=${encodeURIComponent('Hola, me comunico desde la web para consultar por el local de ' + local.nombre)}`;
          const telLink = `tel:${local.telefono.replace(/[^0-9+]/g, '')}`;

          return (
            <article
              data-local-card={local.id}
              data-ciudad={local.ciudad}
              data-lat={local.lat}
              data-lng={local.lng}
              class:list={[
                'local-card group relative cursor-pointer rounded-card border bg-tarjeta p-4',
                local.central
                  ? 'border-amarilloOscuro ring-1 ring-amarilloOscuro/40'
                  : 'border-black/10 hover:border-black/25'
              ]}
            >
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-bold text-base text-tintaFuerte group-hover:text-black">
                  {local.nombre}
                </h3>
                {local.central && (
                  <span class="shrink-0 rounded-full bg-amarillo px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wide text-carbon">
                    Casa Central
                  </span>
                )}
              </div>

              <div class="mt-3 space-y-1.5 text-xs text-tinta/90">
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 shrink-0 text-carbon/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" />
                    <circle cx="12" cy="9" r="2.5" />
                  </svg>
                  <span class="font-medium text-tintaFuerte">{local.direccion}</span>
                </div>

                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 shrink-0 text-carbon/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  <a href={telLink} class="font-bold text-tintaFuerte hover:underline">
                    {local.telefono}
                  </a>
                </div>
              </div>

              <!-- Botones de acción rápida -->
              <div class="mt-4 flex flex-wrap items-center gap-2 pt-2 border-t border-black/5">
                <button
                  type="button"
                  data-btn-focus-map
                  class="inline-flex h-8 items-center gap-1.5 rounded-full bg-carbon px-3 text-[11px] font-bold text-amarillo cursor-pointer hover:bg-tintaFuerte"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                  Ver en mapa
                </button>

                <a
                  href={comoLlegar}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex h-8 items-center gap-1 rounded-full border border-black/15 bg-white px-3 text-[11px] font-bold text-tintaFuerte hover:border-black/40 hover:bg-black/5"
                >
                  Cómo llegar
                </a>

                <a
                  href={waLocal}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex h-8 items-center gap-1.5 rounded-full border border-black/15 bg-white px-3 text-[11px] font-bold text-tintaFuerte hover:border-black/40 hover:bg-black/5"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2a10 10 0 0 0-8.7 15L2 22l5.2-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.4 0-.5s-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.6.6 2.2.7 3 .6a2.5 2.5 0 0 0 1.7-1.2 2 2 0 0 0 .1-1.2c-.1-.1-.3-.2-.6-.3Z"/>
                  </svg>
                  WhatsApp
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Mapa interactivo -->
      <div class="lg:col-span-7 sticky top-20">
        <div class="relative overflow-hidden rounded-card border border-black/15 bg-fila h-[320px] sm:h-[460px] lg:h-[600px]">
          <div id="chiply-mapa" class="h-full w-full z-0"></div>

          <!-- Botón flotante para restablecer la vista de toda la provincia -->
          <button
            type="button"
            id="btn-ver-todos"
            class="absolute bottom-4 right-4 z-[400] inline-flex items-center gap-2 rounded-full bg-carbon px-4 py-2 text-xs font-bold text-amarillo cursor-pointer hover:bg-tintaFuerte active:bg-tintaFuerte"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
            </svg>
            Ver toda la provincia
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import type { Marker } from 'leaflet';
  import { LOCALES_CHIPLY } from '../data/locales';

  /*
   * Leaflet pesa 156 KB (46 gzip) y el mapa está al final de la página: se baja recién
   * cuando la sección se acerca a la pantalla, o en el primer toque adentro de ella
   * (lo que ocurra primero). Si el toque cae sobre un botón o una tarjeta, se repite
   * cuando el mapa ya está listo, porque ese clic llegó antes que sus listeners.
   */
  const mapContainer = document.getElementById('chiply-mapa');
  const seccionDonde = document.getElementById('donde');
  let iniciado = false;

  async function iniciarMapa(): Promise<void> {
    if (iniciado || !mapContainer) return;
    iniciado = true;
    const contenedor: HTMLElement = mapContainer;
    const [{ default: L }] = await Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')]);

    // 1. Inicializar mapa Leaflet centrado en Misiones
    const map = L.map(contenedor, {
      scrollWheelZoom: false,
    });

    // 2. Capa de tiles. Antes era CartoDB Voyager, pero ese endpoint gratis sin
    // cuenta quedó dado de baja -- cada tile devuelve un cartel de "API KEY
    // REQUIRED" en vez de mapa. OpenStreetMap estándar es gratis y no pide cuenta.
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
      subdomains: 'abc',
    }).addTo(map);

    // Habilitar zoom de rueda al hacer foco en el mapa
    map.on('focus', () => map.scrollWheelZoom.enable());
    map.on('blur', () => map.scrollWheelZoom.disable());

    // 3. Generador de marcador HTML estilizado
    const createMarkerIcon = (isCentral = false, isActive = false) => {
      return L.divIcon({
        className: 'chiply-marker-wrap',
        html: `
          <div class="chiply-pin ${isCentral ? 'is-central' : ''} ${isActive ? 'is-active' : ''}">
            <span class="pin-dot"></span>
          </div>
        `,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -30],
      });
    };

    const markers: Record<string, Marker> = {};
    const bounds = L.latLngBounds([]);

    // 4. Crear marcadores y popups
    LOCALES_CHIPLY.forEach((loc) => {
      const latLng: [number, number] = [loc.lat, loc.lng];
      bounds.extend(latLng);

      const marker = L.marker(latLng, {
        icon: createMarkerIcon(loc.central, false),
        title: loc.nombre,
      }).addTo(map);

      const comoLlegar = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.direccion + ', ' + loc.ciudad + ', Misiones')}`;
      const waLocal = `https://wa.me/${loc.whatsapp}?text=${encodeURIComponent('Hola, me comunico desde la web para consultar por el local de ' + loc.nombre)}`;

      const popupHtml = `
        <div class="chiply-popup-content">
          <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
            ${loc.central ? '<span class="chiply-badge-central">Casa Central</span>' : ''}
          </div>
          <h4 style="font-weight:700; font-size:14px; color:#18181b; margin:0 0 4px 0; line-height:1.2;">${loc.nombre}</h4>
          <p style="font-size:12px; color:#52525b; margin:0 0 4px 0;">${loc.direccion}</p>
          <p style="font-size:12px; font-weight:700; color:#18181b; margin:0 0 10px 0;">📞 ${loc.telefono}</p>
          <div style="display:flex; gap:8px;">
            <a href="${comoLlegar}" target="_blank" rel="noopener" class="chiply-popup-btn btn-dark">
              Cómo llegar
            </a>
            <a href="${waLocal}" target="_blank" rel="noopener" class="chiply-popup-btn btn-wa">
              WhatsApp
            </a>
          </div>
        </div>
      `;

      marker.bindPopup(popupHtml, {
        offset: [0, -10],
        closeButton: true,
      });

      marker.on('click', () => {
        highlightCard(loc.id);
      });

      markers[loc.id] = marker;
    });

    // Ajustar límites iniciales para ver todas las sucursales. invalidateSize()
    // antes es necesario: Leaflet mide el contenedor al crear el mapa, y en ese
    // momento (sticky adentro de una grilla que todavía está acomodando el resto de
    // la sección) a veces toma un tamaño chico o desactualizado -- fitBounds calcula
    // el zoom con esa medida vieja y termina metiendo un zoom de calle en vez de
    // mostrar la provincia entera. Remedir fuerza a recalcular contra el tamaño real.
    map.invalidateSize();
    map.fitBounds(bounds, { padding: [40, 40] });

    /*
     * El mapa queda encerrado en la region de las sucursales: no se puede alejar
     * mas de lo que entra la provincia ni arrastrar fuera de ahi.
     *
     * Dos motivos. El practico: es un mapa de nueve locales de Misiones, no un
     * atlas -- alejarse hasta ver medio continente no le sirve a nadie que este
     * buscando donde comprar una bateria. Y el otro: los tiles son imagenes y los
     * nombres vienen dibujados adentro del PNG, asi que en esa escala aparecia
     * "Falkland Islands" sin ninguna forma de cambiarlo desde el codigo. Lo que si
     * se puede decidir es hasta donde llega el mapa.
     *
     * El minimo se toma DESPUES de fitBounds a proposito: es el zoom con el que
     * entran las nueve sucursales en este contenedor, que depende del tamano de
     * pantalla y no se puede escribir como constante. Desde ahi se dejan dos
     * niveles mas de alejamiento y un margen de arrastre amplio: alcanza para
     * mirar la provincia entera con sus vecinas alrededor y sigue estando muy
     * lejos del Atlantico Sur.
     */
    const ZOOM_SUELTO = 2;
    map.setMinZoom(map.getZoom() - ZOOM_SUELTO);
    map.setMaxBounds(bounds.pad(2));
    map.options.maxBoundsViscosity = 1;

    const listaLocales = document.getElementById('lista-locales');

    // Función para resaltar tarjeta en la lista
    function highlightCard(id: string) {
      document.querySelectorAll<HTMLElement>('[data-local-card]').forEach((card) => {
        const isTarget = card.getAttribute('data-local-card') === id;
        if (isTarget) {
          card.classList.add('border-carbon', 'bg-white');
          card.classList.remove('border-black/10', 'border-amarilloOscuro');
          if (listaLocales) {
            const cardTop = card.offsetTop - listaLocales.offsetTop;
            listaLocales.scrollTo({ top: Math.max(0, cardTop - 10), behavior: 'smooth' });
          }
        } else {
          card.classList.remove('border-carbon', 'bg-white');
          const isCentral = card.getAttribute('data-local-card') === 'obera-central';
          if (isCentral) {
            card.classList.add('border-amarilloOscuro');
          } else {
            card.classList.add('border-black/10');
          }
        }
      });

      LOCALES_CHIPLY.forEach((loc) => {
        const m = markers[loc.id];
        if (m) {
          m.setIcon(createMarkerIcon(loc.central, loc.id === id));
        }
      });
    }

    // Interacción al hacer click en cualquier tarjeta o botón "Ver en mapa"
    document.querySelectorAll<HTMLElement>('[data-local-card]').forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;

        const id = card.getAttribute('data-local-card');
        const lat = parseFloat(card.getAttribute('data-lat') ?? '0');
        const lng = parseFloat(card.getAttribute('data-lng') ?? '0');

        if (id && lat && lng) {
          highlightCard(id);
          map.flyTo([lat, lng], 15, { duration: 1.2 });
          const m = markers[id];
          if (m) {
            setTimeout(() => m.openPopup(), 600);
          }
          if (window.innerWidth < 1024) {
            const mapaWrap = document.getElementById('chiply-mapa');
            mapaWrap?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      });
    });

    // Botón para volver a ver toda la provincia
    document.getElementById('btn-ver-todos')?.addEventListener('click', () => {
      map.flyToBounds(bounds, { padding: [40, 40], duration: 1.2 });
      document.querySelectorAll<HTMLElement>('[data-local-card]').forEach((c) => {
        c.classList.remove('border-carbon', 'bg-white');
        const isCentral = c.getAttribute('data-local-card') === 'obera-central';
        if (isCentral) {
          c.classList.add('border-amarilloOscuro');
        } else {
          c.classList.add('border-black/10');
        }
      });
      LOCALES_CHIPLY.forEach((loc) => {
        const m = markers[loc.id];
        if (m) m.setIcon(createMarkerIcon(loc.central, false));
      });
    });

    // Filtros por ciudad
    document.querySelectorAll<HTMLButtonElement>('[data-filter-ciudad]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const ciudad = btn.getAttribute('data-filter-ciudad');

        document.querySelectorAll<HTMLButtonElement>('[data-filter-ciudad]').forEach((b) => {
          b.classList.remove('bg-amarillo', 'text-tintaFuerte', 'is-active');
          b.classList.add('bg-carbon', 'text-amarillo');
        });
        btn.classList.add('bg-amarillo', 'text-tintaFuerte', 'is-active');
        btn.classList.remove('bg-carbon', 'text-amarillo');

        const filterBounds = L.latLngBounds([]);
        let visibleCount = 0;

        document.querySelectorAll<HTMLElement>('[data-local-card]').forEach((card) => {
          const cardCiudad = card.getAttribute('data-ciudad');
          const id = card.getAttribute('data-local-card');
          const visible = ciudad === 'Todas' || cardCiudad === ciudad;

          card.style.display = visible ? 'block' : 'none';

          if (visible && id && markers[id]) {
            const loc = LOCALES_CHIPLY.find((l) => l.id === id);
            if (loc) {
              filterBounds.extend([loc.lat, loc.lng]);
              visibleCount++;
            }
          }
        });

        if (visibleCount > 0) {
          if (visibleCount === 1) {
            map.flyTo(filterBounds.getCenter(), 15, { duration: 1.2 });
          } else {
            map.flyToBounds(filterBounds, { padding: [50, 50], maxZoom: 15, duration: 1.2 });
          }
        }

        if (listaLocales) {
          listaLocales.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });
  }

  if (mapContainer && seccionDonde) {
    if ('IntersectionObserver' in window) {
      const observador = new IntersectionObserver(
        (entradas) => {
          if (!entradas.some((e) => e.isIntersecting)) return;
          observador.disconnect();
          void iniciarMapa();
        },
        { rootMargin: '600px 0px' },
      );
      observador.observe(seccionDonde);
    } else {
      void iniciarMapa();
    }
    seccionDonde.addEventListener(
      'pointerdown',
      (evento) => {
        if (iniciado) return;
        const objetivo = (evento.target as Element).closest<HTMLElement>('button, [data-local-card]');
        void iniciarMapa().then(() => objetivo?.click());
      },
      { once: true, capture: true },
    );
  }
</script>

<style is:global>
  /* Pin personalizado para Leaflet */
  .chiply-marker-wrap {
    background: transparent;
    border: none;
  }
  .chiply-pin {
    width: 30px;
    height: 30px;
    border-radius: 50% 50% 50% 0;
    background: #030303;
    position: absolute;
    transform: rotate(-45deg);
    left: 50%;
    top: 50%;
    margin: -24px 0 0 -15px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
    border: 2px solid #FFF112;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
  }
  .chiply-pin:hover,
  .chiply-pin.is-active {
    transform: rotate(-45deg) scale(1.25);
    border-color: #FFF112;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.5);
    z-index: 999;
  }
  .chiply-pin.is-central {
    background: #FFF112;
    border-color: #030303;
  }
  .chiply-pin .pin-dot {
    width: 9px;
    height: 9px;
    background: #FFF112;
    border-radius: 50%;
    display: block;
  }
  .chiply-pin.is-central .pin-dot {
    background: #030303;
  }

  /* Popups de Leaflet */
  .leaflet-popup-content-wrapper {
    border-radius: 12px !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22) !important;
    padding: 2px !important;
  }
  .leaflet-popup-content {
    margin: 10px 12px !important;
    line-height: 1.4 !important;
  }
  .chiply-badge-central {
    background: #FFF112;
    color: #030303;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 999px;
    display: inline-block;
  }
  .chiply-popup-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .chiply-popup-btn.btn-dark {
    background: #030303;
    color: #FFF112;
  }
  .chiply-popup-btn.btn-dark:hover {
    background: #262626;
  }
  .chiply-popup-btn.btn-wa {
    background: #25D366;
    color: #ffffff;
  }
  .chiply-popup-btn.btn-wa:hover {
    background: #128C7E;
  }
</style>
