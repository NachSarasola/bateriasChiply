---
import BateriaCard from './BateriaCard.astro';
import { getTipos, type Bateria } from '../lib/catalog';
import { whatsappLink, buildGeneralMessage } from '../lib/whatsapp';

interface Props {
  baterias: Bateria[];
}

const { baterias } = Astro.props;
const { SITE, CATALOGO } = Astro.locals.config;
const tipos = getTipos(baterias);
const wa = whatsappLink(buildGeneralMessage(), SITE.whatsapp);

/**
 * Cuántas tarjetas se ven antes de tocar "Ver más". Las demás se renderizan igual
 * (el filtrado tiene que poder encontrarlas), solo van ocultas: con el catálogo
 * entero a la vista, una sola página con 80 baterías es un scroll de varios metros.
 */
const VISIBLES = 12;

/**
 * El mockup pone una fotito de vehículo junto a la píldora activa. Acá van
 * pictogramas de trazo propios (mismo lenguaje que los íconos de Beneficios), no
 * las fotos de stock del mockup — de esas no sabemos la licencia. Con clave por
 * slug real de la categoría; si aparece un tipo nuevo sin ícono, la píldora
 * simplemente no muestra ninguno.
 */
const ICONOS_TIPO: Record<string, string> = {
  automoviles: 'M4 16.5V12l1.6-4A2 2 0 0 1 7.5 6.5h9a2 2 0 0 1 1.9 1.5l1.6 4v4.5M4 16.5a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5M4 16.5V14h16v2.5m-3 0a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5M6 11h12',
  'pick-up-y-suv':
    'M3 16.5V11a1 1 0 0 1 1-1h5v6.5M9 10V6.5a1 1 0 0 1 1-1h3.3a1 1 0 0 1 .87.5L16 9.5M9 16.5h12V13a2 2 0 0 0-1.4-1.9L16 9.5M3 16.5a1.5 1.5 0 0 0 1.5 1.5h1A1.5 1.5 0 0 0 7 16.5m8 0a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5',
  'camiones-y-buses':
    'M3 15.5V7a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v8.5M14 10.5h4.6a1 1 0 0 1 .9.55L21 14v1.5M3 15.5a1.5 1.5 0 0 0 1.5 1.5h.5a1.5 1.5 0 0 0 1.5-1.5m10 0a1.5 1.5 0 0 0 1.5 1.5h.5a1.5 1.5 0 0 0 1.5-1.5m2 0a1.5 1.5 0 0 0 1.5 1.5v0a1.5 1.5 0 0 0 1.5-1.5',
  'maquinarias-y-tractores':
    'M5 17a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 0v0M16.5 17.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM8 13.5V8h3l3.5 3.2h2.3a1 1 0 0 1 1 .84l.4 2.46M8 8H6',
};
---

{/* Aire entre el bloque negro de arriba (header + beneficios) y el titulo: sin
    esa franja de gris, el titulo se lee pegado a la banda. */}
<section id="catalogo" class="pb-14 pt-8 md:pb-20 md:pt-10">
  <div class="mx-auto max-w-shell px-4 sm:px-6 lg:px-10 xl:px-14" data-catalogo data-visibles={VISIBLES}>
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="shrink-0">
        <h2 class="text-3xl font-bold text-tintaFuerte sm:text-seccion">{CATALOGO.titulo}</h2>
        {CATALOGO.bajada && <p class="mt-2 max-w-xl text-tinta/85">{CATALOGO.bajada}</p>}
        {baterias.length > 0 && (
          <p data-contador class="mt-1 text-sm text-tinta/85" aria-live="polite">
            {baterias.length} {baterias.length === 1 ? 'batería' : 'baterías'}
          </p>
        )}
      </div>

      {/* Tira de filtros y buscador alineados a la derecha */}
      {baterias.length > 0 && (
        <div
          class="no-scrollbar -mx-4 flex items-center justify-start overflow-x-auto px-4 py-1 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0"
          data-scroll-fundido="horizontal"
          data-fila-filtros
        >
          <div class="flex shrink-0 items-center gap-2 sm:ml-auto">
            {/* Píldoras sólidas, como en el mockup de Chiply: nunca outline. La
                activa se lee clara (amarillo + texto oscuro) y las inactivas quedan
                oscuras (negro + texto amarillo). */}
            <button
              type="button"
              data-filtro="todos"
              aria-pressed="true"
              class="h-10 shrink-0 rounded-full bg-amarillo px-4 text-sm font-bold text-tintaFuerte transition-opacity hover:opacity-90 active:opacity-75"
            >
              Todas
            </button>
            {tipos.map((t) => (
              <button
                type="button"
                data-filtro={t.slug}
                aria-pressed="false"
                class="flex h-10 shrink-0 items-center gap-1.5 rounded-full bg-carbon px-4 text-sm font-bold text-amarillo transition-opacity hover:opacity-90 active:opacity-75"
              >
                {t.nombre}
                {ICONOS_TIPO[t.slug] && (
                  <svg
                    data-filtro-icono
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="hidden h-4 w-4 shrink-0"
                    aria-hidden="true"
                  >
                    <path d={ICONOS_TIPO[t.slug]} />
                  </svg>
                )}
              </button>
            ))}

            {/* La lupa alineada al final: al hacer clic se ensancha fluidamente hacia
                la izquierda empujando los filtros con animación. */}
            {/* El anillo de foco va en el contenedor y no en el input: el input
                es un rectangulo adentro de una capsula recortada, asi que su
                anillo aparecia cortado en las cuatro esquinas. Aca sigue la
                forma de la pildora. */}
            <div
              data-buscador-wrap
              class="relative h-10 w-10 shrink-0 overflow-hidden rounded-full bg-carbon transition-[width] duration-300 ease-out focus-within:ring-2 focus-within:ring-inset focus-within:ring-amarillo"
            >
              <input
                type="search"
                data-buscador
                placeholder="Código o medida..."
                aria-label="Buscar batería por código o medida"
                class="h-10 w-full bg-transparent pl-4 pr-11 text-base text-amarillo outline-none placeholder:text-amarillo/60 sm:text-sm"
              />
              <button
                type="button"
                data-buscador-toggle
                aria-label="Buscar por código o medida"
                aria-expanded="false"
                class="absolute right-0 top-0 flex h-10 w-10 shrink-0 items-center justify-center text-amarillo hover:text-white transition-colors"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="7" />
                  <path d="M20 20l-3.5-3.5" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>

    {
      baterias.length === 0 ? (
        <p class="mt-10 rounded-card border border-black/10 bg-tarjeta p-8 text-center text-tinta/70">
          El catálogo se está cargando. Mientras tanto, escribinos por WhatsApp y te
          decimos qué batería lleva tu vehículo.
        </p>
      ) : (
        <div>
          {/* El mockup es un diseño fijo a 1920px con 3 columnas siempre; acá se
              respeta esa grilla desde `lg` (donde ya entran cómodas) y se cae a 2 y
              a 1 en pantallas más chicas, que es lo único que el mockup no define. */}
          <div
            class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-catalogo 2xl:grid-cols-4"
            data-reveal="escalonado"
          >
            {baterias.map((b, i) => (
              <BateriaCard bateria={b} prioridad={i < 4} indice={i} />
            ))}
          </div>

          {/* Estado vacío del filtro. No es un callejón sin salida: el que buscó una
              medida que no está es justamente el que hay que mandar a WhatsApp. */}
          <div data-sin-resultados class="hidden py-14 text-center">
            <p class="text-lg font-bold text-tintaFuerte">No encontramos esa medida.</p>
            <p class="mx-auto mt-2 max-w-md text-tinta/85">
              Puede que la tengamos sin publicar o que entre otra equivalente.
              Pasanos el vehículo y te confirmamos en el momento.
            </p>
            <a
              href={wa}
              target="_blank"
              rel="noopener"
              class="mt-6 inline-flex h-12 items-center rounded-card bg-carbon px-6 text-sm font-bold text-amarillo hover:bg-tintaFuerte active:bg-tintaFuerte"
            >
              Consultar por WhatsApp
            </a>
          </div>

          <div class="mt-10 text-center">
            <button
              type="button"
              data-ver-mas
              class="hidden h-12 rounded-card border-boton border-carbon px-8 text-sm font-bold text-tintaFuerte hover:bg-carbon hover:text-amarillo active:bg-carbon active:text-amarillo"
            >
              Ver todas
            </button>
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-catalogo]');
  if (raiz) {
    const buscador = raiz.querySelector<HTMLInputElement>('[data-buscador]');
    const buscadorWrap = raiz.querySelector<HTMLElement>('[data-buscador-wrap]');
    const buscadorToggle = raiz.querySelector<HTMLButtonElement>('[data-buscador-toggle]');
    const filaFiltros = raiz.querySelector<HTMLElement>('[data-fila-filtros]');
    const filtros = [...raiz.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const tarjetas = [...raiz.querySelectorAll<HTMLElement>('[data-bateria]')];
    const contador = raiz.querySelector<HTMLElement>('[data-contador]');
    const vacio = raiz.querySelector<HTMLElement>('[data-sin-resultados]');
    const verMas = raiz.querySelector<HTMLButtonElement>('[data-ver-mas]');
    const tope = Number(raiz.dataset.visibles ?? 12);

    let tipo = 'todos';
    let texto = '';
    let expandido = false;

    const sinAcentos = (v: string) => v.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    /** Se desvanece y, reci\u00e9n cuando termina, colapsa el lugar en la grilla. */
    function ocultarSuave(el: HTMLElement): void {
      el.classList.add('hidden');
    }

    function mostrarSuave(el: HTMLElement): void {
      el.classList.remove('hidden');
    }

    function aplicar(primera = false): void {
      // Con filtro o búsqueda activa no hay recorte: si alguien buscó "moto" quiere
      // ver las cinco motos, no ocho de ellas y un botón.
      const filtrando = tipo !== 'todos' || texto.length > 0;
      // "12 x 65" es una medida, no tres palabras: se pega antes de partir en
      // terminos. Sin esto, cada digito suelto matcheaba media tabla.
      const termino = sinAcentos(texto.toLowerCase())
        .replace(/(\d)\s*x\s*(\d)/g, '$1x$2')
        .trim();
      const palabras = termino.split(/\s+/).filter(Boolean);

      let visibles = 0;
      for (const tarjeta of tarjetas) {
        const coincideTipo = tipo === 'todos' || tarjeta.dataset.tipo === tipo;
        const buscable = tarjeta.dataset.buscar ?? '';
        // Todas las palabras tienen que estar: "12x65 reforzada" no puede traer
        // cualquier cosa que tenga "reforzada".
        const coincideTexto = palabras.every((p) => buscable.includes(p));
        const pasa = coincideTipo && coincideTexto;

        const recortada = !filtrando && !expandido && visibles >= tope;
        const mostrar = pasa && !recortada;
        // Al cargar la página no hay nada que transicionar: solo importa que el
        // recorte inicial no aparezca ni por un frame antes de esconderse.
        if (primera) {
          tarjeta.classList.toggle('hidden', !mostrar);
        } else if (mostrar) {
          mostrarSuave(tarjeta);
        } else {
          ocultarSuave(tarjeta);
        }
        if (pasa) visibles += 1;
      }

      if (contador) {
        contador.textContent = `${visibles} ${visibles === 1 ? 'batería' : 'baterías'}`;
      }
      vacio?.classList.toggle('hidden', visibles > 0);
      if (verMas) {
        const hayMas = !filtrando && !expandido && visibles > tope;
        verMas.classList.toggle('hidden', !hayMas);
      }
    }

    buscador?.addEventListener('input', () => {
      texto = buscador.value;
      aplicar();
    });

    const ANCHO_ABIERTO = 240;

    function abrirBuscador(): void {
      if (!buscadorWrap || !buscadorToggle) return;
      buscadorWrap.style.width = `${ANCHO_ABIERTO}px`;
      buscadorToggle.setAttribute('aria-expanded', 'true');
      buscador?.focus();
      const irAlFinal = () => filaFiltros?.scrollTo({ left: filaFiltros.scrollWidth, behavior: 'smooth' });
      buscadorWrap.addEventListener('transitionend', irAlFinal, { once: true });
      setTimeout(irAlFinal, 320);
    }

    function cerrarBuscador(): void {
      if (!buscadorWrap || !buscadorToggle || !buscador) return;
      if (buscador.value.trim().length > 0) return;
      buscadorWrap.style.width = '';
      buscadorToggle.setAttribute('aria-expanded', 'false');
    }

    // Prevenir que mousedown robe foco prematuramente
    buscadorToggle?.addEventListener('mousedown', (e) => {
      e.preventDefault();
    });

    buscadorToggle?.addEventListener('click', (e) => {
      e.preventDefault();
      const abierto = buscadorToggle.getAttribute('aria-expanded') === 'true';
      if (abierto) {
        if (!buscador?.value.trim()) {
          cerrarBuscador();
          buscador?.blur();
        } else {
          buscador?.focus();
        }
      } else {
        abrirBuscador();
      }
    });

    buscador?.addEventListener('focus', () => {
      abrirBuscador();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (!buscadorWrap?.contains(target)) {
        cerrarBuscador();
      }
    });

    buscador?.addEventListener('keydown', (evento) => {
      if (evento.key !== 'Escape') return;
      buscador.value = '';
      texto = '';
      aplicar();
      cerrarBuscador();
      buscador.blur();
    });

    for (const boton of filtros) {
      boton.addEventListener('click', () => {
        tipo = boton.dataset.filtro ?? 'todos';
        for (const otro of filtros) {
          // Píldora sólida: la activa es amarilla con texto oscuro, las demás quedan
          // negras con texto amarillo (ver el markup estático arriba, mismo par de
          // clases para el primer render).
          const activo = otro === boton;
          otro.setAttribute('aria-pressed', String(activo));
          otro.classList.toggle('bg-amarillo', activo);
          otro.classList.toggle('text-tintaFuerte', activo);
          otro.classList.toggle('bg-carbon', !activo);
          otro.classList.toggle('text-amarillo', !activo);
          // El pictograma del vehículo solo se ve en la píldora activa, como en
          // el mockup — "Todas" no tiene ícono (no es un tipo de vehículo).
          otro.querySelector('[data-filtro-icono]')?.classList.toggle('hidden', !activo);
        }
        aplicar();
      });
    }

    verMas?.addEventListener('click', () => {
      expandido = true;
      aplicar();
    });

    aplicar(true);
  }
</script>
