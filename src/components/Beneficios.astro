---
/**
 * Franja de beneficios debajo del header: los argumentos de venta del mostrador,
 * escritos como los diría el vendedor.
 *
 * Fue una cinta que pasaba sola y dejó de serlo. El contenido no daba para ese
 * formato: una vuelta entera eran 5700px, o sea dos minutos de espera para leer
 * cinco frases que son justamente las que cierran la venta. Encima el movimiento
 * era permanente y estaba arriba de lo único que hay que mirar, que es el
 * catálogo. Ahora están los cinco a la vez y no se mueve nada.
 *
 * Va sobre el mismo negro del header y sin borde: header y beneficios se leen
 * como un solo bloque con jerarquía adentro, en vez de dos bandas oscuras de
 * negros distintos apiladas.
 *
 * Los íconos son trazos simples y todos del mismo peso: un set de pictogramas de
 * stock, cada uno con su estilo, es de lo que más delata una plantilla.
 */
const { BENEFICIOS } = Astro.locals.config;

const ICONOS: string[] = [
  // Escudo (garantía)
  'M12 3l7 3v5c0 4.2-2.9 7.8-7 9-4.1-1.2-7-4.8-7-9V6l7-3z',
  // Llave (instalación)
  'M14.7 6.3a4 4 0 105.1 5.1L21 10.6 13.4 3 12 4.4l2.7 1.9zM3 21l7.5-7.5',
  // Camioneta (envío)
  'M3 16V7h11v9M14 10h4l3 3v3h-7M7 19a2 2 0 100-4 2 2 0 000 4zm10 0a2 2 0 100-4 2 2 0 000 4z',
  // Gota tachada (libre de mantenimiento)
  'M12 3s5 5.6 5 9a5 5 0 01-10 0c0-3.4 5-9 5-9zM4 4l16 16',
  // Flecha circular (recibimos la vieja)
  'M20 12a8 8 0 11-2.3-5.7M20 4v4h-4',
];

const items = BENEFICIOS.map((b, k) => ({ ...b, icono: ICONOS[k % ICONOS.length] }));
---

<section aria-label="Beneficios" class="bg-carbon">
  {/* En celular la franja se pasa con el dedo y cada ítem engancha donde
      corresponde. El ancho de 72% deja medio ítem asomando a la derecha: sin eso
      nadie se entera de que hay cuatro beneficios más. El fundido del borde lo
      maneja el script del layout, que lo apaga cuando ya no queda nada atrás. */}
  <ul
    class="no-scrollbar mx-auto flex max-w-shell snap-x snap-mandatory scroll-px-4 overflow-x-auto px-4 sm:scroll-px-6 sm:px-6 lg:snap-none lg:scroll-px-10 lg:overflow-visible lg:px-10 xl:scroll-px-14 xl:px-14"
    data-scroll-fundido="horizontal"
  >
    {
      items.map((b, i) => (
        <li
          class:list={[
            // Cuantos entran a la vez depende del ancho: uno y medio en celular,
            // dos y medio en una tablet chica, tres y medio en una grande. La
            // fracción que asoma es lo que avisa que hay más.
            'w-[72%] shrink-0 snap-start py-5 pr-5 sm:w-[42%] md:w-[31%] lg:w-auto lg:flex-1 lg:basis-0 lg:shrink lg:px-5',
            // La línea divisoria recién cuando están los cinco en fila: con los
            // ítems enganchando de a uno, cae en cualquier lado.
            i > 0 && 'lg:border-l lg:border-white/10',
            i === 0 && 'lg:pl-0',
          ]}
        >
          <p class="flex items-center gap-2">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 shrink-0 text-amarillo"
              aria-hidden="true"
            >
              <path d={b.icono} />
            </svg>
            <strong class="text-sm font-bold leading-tight text-white">{b.titulo}</strong>
          </p>
          {b.bajada && (
            <span class="mt-1.5 block text-xs leading-snug text-plata/70">{b.bajada}</span>
          )}
        </li>
      ))
    }
  </ul>
</section>
