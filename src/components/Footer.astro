---
import { whatsappLink, buildGeneralMessage, formatearWhatsapp } from '../lib/whatsapp';
import LogoChiply from './LogoChiply.astro';

/**
 * Pie: banda negra de ancho completo con el mismo brillo diagonal que el header, y 3
 * columnas -- red social, ubicación, WhatsApp -- cada una con su ícono en placa
 * amarilla. La columna del medio lleva dirección + horarios reales (el mockup repetía
 * la misma dirección tres veces, relleno de maqueta).
 */
const { MEDIOS_DE_PAGO, SITE } = Astro.locals.config;
const consulta = whatsappLink(buildGeneralMessage(), SITE.whatsapp);
const anio = new Date().getFullYear();

const iconoPlaca =
  'flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amarillo text-tintaFuerte';
---

<footer class="relative overflow-hidden bg-carbon">
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.08) 50%, transparent 68%)"
  >
  </div>

  <div class="relative mx-auto max-w-shell px-4 sm:px-6 lg:px-10 xl:px-14 py-10">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4 border-b border-white/10 pb-6">
      <a href="#inicio" data-logo-top class="cursor-pointer" aria-label="Ir al inicio">
        <LogoChiply clase="h-12 sm:h-14" />
      </a>
      <p class="max-w-sm text-sm text-plata/70">{SITE.descripcion}</p>
    </div>

    <div class="grid gap-8 sm:grid-cols-3">
      <div class="space-y-3">
        <a
          href={SITE.instagram}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-3 text-sm font-medium text-white hover:text-amarillo"
        >
          <span class={iconoPlaca} aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
            </svg>
          </span>
          {SITE.instagramHandle}
        </a>
        {
          SITE.email && (
            <a
              href={`mailto:${SITE.email}`}
              class="flex items-center gap-3 text-sm font-medium text-white hover:text-amarillo"
            >
              <span class={iconoPlaca} aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M3 7l9 6 9-6" />
                </svg>
              </span>
              {SITE.email}
            </a>
          )
        }
      </div>

      <div class="space-y-3">
        <p class="flex items-center gap-3 text-sm font-medium text-white">
          <span class={iconoPlaca} aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" />
              <circle cx="12" cy="9" r="2.4" />
            </svg>
          </span>
          {SITE.direccion}, {SITE.ciudad}
        </p>
        {
          SITE.horarios.map((h) => (
            <p class="flex items-center gap-3 text-sm text-plata/70">
              <span class="w-9 shrink-0" aria-hidden="true" />
              {h}
            </p>
          ))
        }
      </div>

      <div>
        <a href={consulta} target="_blank" rel="noopener" class="flex items-center gap-3">
          <span class={iconoPlaca} aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-8.7 15L2 22l5.2-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.4 0-.5s-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.6.6 2.2.7 3 .6a2.5 2.5 0 0 0 1.7-1.2 2 2 0 0 0 .1-1.2c-.1-.1-.3-.2-.6-.3Z" />
            </svg>
          </span>
          <span class="precio text-2xl font-extrabold italic text-amarillo hover:text-amarilloOscuro">
            {formatearWhatsapp(SITE.whatsapp)}
          </span>
        </a>
        <p class="mt-2 text-sm text-plata/70">{MEDIOS_DE_PAGO.join(' · ')}</p>
      </div>
    </div>
  </div>

  <div class="relative mx-auto max-w-shell px-4 sm:px-6 lg:px-10 xl:px-14">
    {/* El padding derecho de sm para arriba le deja lugar al botón flotante del
        carrito (56px + 24 de margen): sin eso, al llegar al final del scroll el
        botón queda justo encima de la firma del estudio. */}
    <div
      class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 py-[18px] text-[13px] text-plata/60 sm:pr-24"
    >
      <span>© {anio} {SITE.nombre} · Todos los derechos reservados</span>
      <span>{SITE.ciudad} · Argentina</span>

      {/* Firmas de estudio: Laboratorio Sur y Estudio Visum */}
      <div class="flex flex-wrap items-center gap-4 sm:gap-5">
        <a
          href="https://laboratoriosur.com"
          target="_blank"
          rel="noopener"
          aria-label="Sitio hecho por Laboratorio Sur"
          class="group flex items-center gap-3.5 font-sans"
        >
          <span
            aria-hidden="true"
            class="sello-ls flex h-[34px] w-[34px] items-center justify-center bg-[#0A0A0A] text-[13px] font-extrabold tracking-[-0.02em] text-[#F8F6F2] transition-opacity group-hover:opacity-85 ring-1 ring-white/15"
          >
            LS
          </span>
          <span class="flex flex-col gap-0.5 leading-none">
            <span class="text-[10px] font-bold uppercase tracking-[0.09em] text-plata/60">
              Hecho por
            </span>
            <span class="text-[14px] font-bold text-white transition-colors group-hover:text-white/85">
              Laboratorio Sur
            </span>
          </span>
        </a>

        <span class="h-4 w-px bg-white/15" aria-hidden="true" />

        <a
          href="https://www.instagram.com/estudio.visum/"
          target="_blank"
          rel="noopener"
          aria-label="Estudio Visum en Instagram"
          class="group flex items-center gap-3 font-sans"
        >
          <img
            src="/marca/estudio-visum.jpg"
            alt="Estudio Visum"
            width="34"
            height="34"
            class="h-[34px] w-[34px] rounded-[7px] object-cover ring-1 ring-white/15 transition-opacity group-hover:opacity-85"
          />
          <span class="text-[14px] font-bold text-white transition-colors group-hover:text-white/85">
            Estudio Visum
          </span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* El sello de Laboratorio Sur: cuña naranja en la esquina superior izquierda. Es un
     triángulo CSS clásico — un elemento sin tamaño al que solo se le pintan dos
     bordes, el de arriba en color y el de la derecha transparente. El overflow del
     sello lo recorta contra la curva de 7px. El naranja es el acento del estudio, no
     el amarillo de Chiply — esta firma se ve igual en todos los sitios que firmamos,
     sin importar la paleta del cliente. */
  .sello-ls {
    position: relative;
    overflow: hidden;
    border-radius: 7px;
  }
  .sello-ls::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 12.8px solid #ff3000;
    border-right: 12.8px solid transparent;
  }
</style>
