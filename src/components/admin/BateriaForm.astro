---
import FotoUploader from './FotoUploader.astro';
import type { Bateria } from '../../lib/catalog';

interface Props {
  bateria?: Bateria;
  /** Los tipos ya cargados, para que el datalist evite que se escriban dos veces distinto. */
  tipos: string[];
}

const { bateria, tipos } = Astro.props;

const input =
  'mt-1 w-full rounded-fila border border-white/15 bg-admin-campo px-3 py-3 text-[15px] text-white outline-none transition-colors focus:border-amarillo';
const etiqueta = 'text-[13px] font-bold text-white';
const ayuda = 'text-xs text-plata/60';
---

<form data-bateria-form data-id={bateria?.id ?? ''} class="max-w-2xl space-y-6">
  <p
    data-error
    class="hidden rounded-fila border border-red-500/50 bg-red-500/10 px-4 py-3 text-sm font-bold text-red-400"
  >
  </p>

  <section class="space-y-4 rounded-card border border-white/10 bg-admin-panel p-5">
    <h2 class="text-base font-bold text-white">Identificación</h2>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class={etiqueta}>Código</span>
        <input name="codigo" type="text" required value={bateria?.codigo} placeholder="12X65" class={input} />
        <span class={ayuda}>El que pide el cliente por teléfono.</span>
      </label>

      <label class="block">
        <span class={etiqueta}>Nombre</span>
        <input
          name="nombre"
          type="text"
          required
          value={bateria?.nombre}
          placeholder="Chiply 12x65 Reforzada"
          class={input}
        />
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class={etiqueta}>Tipo</span>
        <input
          name="tipoNombre"
          type="text"
          required
          list="tipos-existentes"
          value={bateria?.tipoNombre}
          placeholder="Automóviles"
          class={input}
        />
        <datalist id="tipos-existentes">
          {tipos.map((t) => <option value={t} />)}
        </datalist>
        <span class={ayuda}>Es el filtro del catálogo. Si escribís uno nuevo, se crea solo.</span>
      </label>

      <label class="block">
        <span class={etiqueta}>Marca</span>
        <input name="marca" type="text" value={bateria?.marca} placeholder="Opcional" class={input} />
      </label>
    </div>

    <label class="block">
      <span class={etiqueta}>Aplicación</span>
      <input
        name="aplicacion"
        type="text"
        value={bateria?.aplicacion}
        placeholder="T/Corolla - Ecosport - Gol Trend"
        class={input}
      />
      <span class={ayuda}>
        Los vehículos que la llevan. Es por donde más busca la gente: conviene poner
        todos los modelos que te pregunten.
      </span>
    </label>
  </section>

  <section class="space-y-4 rounded-card border border-white/10 bg-admin-panel p-5">
    <h2 class="text-base font-bold text-white">Precio</h2>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class={etiqueta}>Precio</span>
        <input name="precio" type="number" min="0" step="1" required value={bateria?.precio ?? 0} class={input} />
        <span class={ayuda}>Con 0 la ficha dice "Consultar" y el botón manda a WhatsApp en vez de al carrito.</span>
      </label>

      <label class="block">
        <span class={etiqueta}>Precio tachado</span>
        <input
          name="precioTachado"
          type="number"
          min="1"
          step="1"
          value={bateria?.precioTachado ?? ''}
          placeholder="Opcional"
          class={input}
        />
        <span class={ayuda}>Si es mayor al precio, se muestra el % de descuento.</span>
      </label>
    </div>
  </section>

  <section class="space-y-4 rounded-card border border-white/10 bg-admin-panel p-5">
    <h2 class="text-base font-bold text-white">Ficha técnica</h2>
    <p class={ayuda}>Todo lo de acá es opcional: lo que dejes vacío no aparece en la ficha.</p>

    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block">
        <span class={etiqueta}>Tensión (V)</span>
        <input name="tension" type="number" min="1" step="1" value={bateria?.tension ?? 12} class={input} />
      </label>

      <label class="block">
        <span class={etiqueta}>Capacidad (Ah)</span>
        <input name="capacidadAh" type="number" min="1" step="1" value={bateria?.capacidadAh ?? ''} class={input} />
      </label>

      <label class="block">
        <span class={etiqueta}>Garantía (meses)</span>
        <input
          name="garantiaMeses"
          type="number"
          min="1"
          step="1"
          value={bateria?.garantiaMeses ?? 12}
          class={input}
        />
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block">
        <span class={etiqueta}>Arranque en frío (CCA)</span>
        <input name="cca" type="number" min="1" step="1" value={bateria?.cca ?? ''} class={input} />
      </label>

      <label class="block">
        <span class={etiqueta}>Reserva (min)</span>
        <input name="reservaRc" type="number" min="1" step="1" value={bateria?.reservaRc ?? ''} class={input} />
      </label>

      <label class="block">
        <span class={etiqueta}>Borne positivo</span>
        <select name="borne" class={input}>
          <option value="" class="bg-admin-campo text-white" selected={!bateria?.borne}>Sin especificar</option>
          <option value="derecha" class="bg-admin-campo text-white" selected={bateria?.borne === 'derecha'}>A la derecha</option>
          <option value="izquierda" class="bg-admin-campo text-white" selected={bateria?.borne === 'izquierda'}>A la izquierda</option>
        </select>
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block">
        <span class={etiqueta}>Largo (mm)</span>
        <input name="largoMm" type="number" min="1" step="1" value={bateria?.largoMm ?? ''} class={input} />
      </label>

      <label class="block">
        <span class={etiqueta}>Ancho (mm)</span>
        <input name="anchoMm" type="number" min="1" step="1" value={bateria?.anchoMm ?? ''} class={input} />
      </label>

      <label class="block">
        <span class={etiqueta}>Alto (mm)</span>
        <input name="altoMm" type="number" min="1" step="1" value={bateria?.altoMm ?? ''} class={input} />
      </label>
    </div>

    <label class="block">
      <span class={etiqueta}>Descripción</span>
      <textarea name="descripcion" rows="3" class={input}>{bateria?.descripcion}</textarea>
      <span class={ayuda}>Una o dos líneas, como se lo explicarías a un cliente en el mostrador.</span>
    </label>
  </section>

  <section class="space-y-4 rounded-card border border-white/10 bg-admin-panel p-5">
    <h2 class="text-base font-bold text-white">Publicación</h2>

    <div class="flex flex-wrap gap-5 text-sm text-plata">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="destacado" checked={bateria?.destacado} class="accent-amarillo" />
        Destacada (va en la portada)
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <input
          type="checkbox"
          name="conMantenimiento"
          checked={bateria ? !bateria.libreMantenimiento : false}
          class="accent-amarillo"
        />
        Requiere control de nivel
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="agotado" checked={bateria ? !bateria.stock : false} class="accent-amarillo" />
        Sin stock
      </label>
    </div>

    <div>
      <span class="block pb-1 text-[13px] font-bold text-white">Fotos</span>
      <FotoUploader inicial={bateria?.imagenes ?? []} />
    </div>
  </section>

  <div class="flex items-center gap-4 pt-1">
    <button
      type="submit"
      class="rounded-card bg-amarillo px-6 py-3.5 text-[15px] font-bold text-carbon transition-colors hover:bg-amarilloOscuro"
    >
      {bateria ? 'Guardar cambios' : 'Crear batería'}
    </button>
    {
      bateria && (
        <button type="button" data-eliminar class="text-sm text-plata/60 underline hover:text-red-400">
          Eliminar
        </button>
      )
    }
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-bateria-form]');
  const error = form?.querySelector<HTMLElement>('[data-error]');

  function mostrarError(mensaje: string): void {
    if (!error) return;
    error.textContent = mensaje;
    error.classList.remove('hidden');
    error.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }

  /** Los number vacíos llegan como '': se mandan null para que el server los deje en NULL. */
  function num(data: FormData, campo: string): number | null {
    const crudo = String(data.get(campo) ?? '').trim();
    return crudo === '' ? null : Number(crudo);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    error?.classList.add('hidden');

    const data = new FormData(form);
    const id = form.dataset.id;

    const payload = {
      codigo: String(data.get('codigo') ?? ''),
      nombre: String(data.get('nombre') ?? ''),
      marca: String(data.get('marca') ?? ''),
      tipoNombre: String(data.get('tipoNombre') ?? ''),
      aplicacion: String(data.get('aplicacion') ?? ''),
      precio: Number(data.get('precio')),
      precioTachado: num(data, 'precioTachado'),
      tension: num(data, 'tension'),
      capacidadAh: num(data, 'capacidadAh'),
      reservaRc: num(data, 'reservaRc'),
      cca: num(data, 'cca'),
      garantiaMeses: num(data, 'garantiaMeses'),
      largoMm: num(data, 'largoMm'),
      anchoMm: num(data, 'anchoMm'),
      altoMm: num(data, 'altoMm'),
      borne: String(data.get('borne') ?? ''),
      descripcion: String(data.get('descripcion') ?? ''),
      destacado: data.get('destacado') === 'on',
      libreMantenimiento: data.get('conMantenimiento') !== 'on',
      stock: data.get('agotado') !== 'on',
      imagenes: JSON.parse(String(data.get('imagenes') ?? '[]')),
    };

    const url = id ? `/api/admin/baterias/${id}` : '/api/admin/baterias';
    const res = await fetch(url, {
      method: id ? 'PUT' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      const cuerpo = (await res.json().catch(() => ({}))) as { error?: string };
      mostrarError(cuerpo.error ?? 'No se pudo guardar. Probá de nuevo.');
      return;
    }

    window.location.href = '/admin/baterias';
  });

  form?.querySelector('[data-eliminar]')?.addEventListener('click', async () => {
    const id = form?.dataset.id;
    if (!id) return;
    if (!confirm('¿Eliminar esta batería? No se puede deshacer.')) return;

    const res = await fetch(`/api/admin/baterias/${id}`, { method: 'DELETE' });
    if (res.ok) window.location.href = '/admin/baterias';
    else mostrarError('No se pudo eliminar. Probá de nuevo.');
  });
</script>
