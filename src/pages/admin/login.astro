---
import LogoChiply from '../../components/LogoChiply.astro';
import { leerCookie, verificarSesion } from '../../lib/auth';
import '../../styles/fuentes.css';

// El middleware excluye esta ruta a proposito (si no, loopearia contra si misma).
// Si ya hay sesion valida, no tiene sentido mostrar el formulario de nuevo.
const cookie = leerCookie(Astro.request.headers.get('cookie'), 'sesion');
const yaLogueado = await verificarSesion(cookie, Astro.locals.runtime.env.ADMIN_SECRET);
if (yaLogueado) return Astro.redirect('/admin/baterias');

const error = Astro.url.searchParams.get('error') === '1';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar | Baterías Chiply</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-black font-sans text-white antialiased">
    <div class="w-full max-w-sm px-4">
      <div class="flex justify-center pb-8">
        <LogoChiply clase="h-14 sm:h-16" />
      </div>

      <form method="POST" action="/api/admin/login" class="rounded-card border border-white/10 bg-admin-panel p-6 text-white shadow-2xl">
        <label class="block">
          <span class="text-[13px] font-bold text-plata">Contraseña</span>
          <input
            name="password"
            type="password"
            required
            autofocus
            class="mt-1 w-full rounded-fila border border-white/15 bg-admin-campo px-3 py-3 text-[15px] text-white outline-none transition-colors focus:border-amarillo"
          />
        </label>

        {
          error && (
            <p class="mt-3 rounded-fila border border-red-500/50 bg-red-500/10 px-3 py-2 text-[13px] font-bold text-red-400">
              Contraseña incorrecta.
            </p>
          )
        }

        <button
          type="submit"
          class="mt-5 w-full rounded-card bg-amarillo py-3.5 text-[15px] font-bold text-carbon transition-colors hover:bg-amarilloOscuro"
        >
          Entrar
        </button>
      </form>
    </div>
  </body>
</html>
